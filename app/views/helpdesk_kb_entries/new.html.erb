<h2>
  <%= link_to l(:label_helpdesk_kb), helpdesk_kb_entries_path(:project_id => @project) %>
  &raquo; <%= l(:button_helpdesk_kb_new_entry) %>
</h2>

<%= form_for @entry, :as => :helpdesk_knowledge_entry,
    :url => helpdesk_kb_entries_path(:project_id => @project), :method => :post do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
  <p>
    <%= f.submit l(:button_create) %>
    <%= link_to l(:button_cancel), helpdesk_kb_entries_path(:project_id => @project) %>
  </p>
<% end %>
