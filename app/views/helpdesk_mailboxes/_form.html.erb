<%# Formular fuer Postfach-Konfiguration (neu/bearbeiten) %>
<%= stylesheet_link_tag 'helpdesk_mailbox_form', :plugin => 'redmine_expert_helpdesk' %>
<%= error_messages_for @mailbox %>

<div class="box tabular"
     id="helpdesk-mailbox-box"
     data-folders-url="<%= url_for(:controller => 'helpdesk_mailboxes', :action => 'folders', :project_id => @project.identifier) %>"
     data-create-folder-url="<%= url_for(:controller => 'helpdesk_mailboxes', :action => 'create_folder', :project_id => @project.identifier) %>"
     data-test-connection-url="<%= url_for(:controller => 'helpdesk_mailboxes', :action => 'test_connection', :project_id => @project.identifier) %>"
     data-presets="<%= h(RedmineExpertHelpdesk::ProviderPresets::PRESETS.to_json) %>"
     data-mailbox-id="<%= @mailbox.id %>"
     data-csrf="<%= form_authenticity_token %>">
  <p>
    <label><%= l(:field_helpdesk_mailbox_address) %> <span class="required">*</span></label>
    <%= text_field_tag 'helpdesk_mailbox[mailbox_address]', @mailbox.mailbox_address,
        :id => 'hd_mailbox_address', :size => 50 %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_provider) %></label>
    <%= select_tag 'helpdesk_mailbox[provider]',
        options_for_select([[l(:label_helpdesk_provider_graph), 'graph'],
                            [l(:label_helpdesk_provider_imap),  'imap']],
                           @mailbox.provider),
        :id => 'hd_provider' %>
    <em class="info"><%= l(:text_helpdesk_provider_info) %></em>
  </p>
  <%# Sits next to the provider, not with the reply templates: the provider says
      how mail comes in, this says how it goes out - and it governs replies,
      initial mails and the autoresponder alike, not just reply templates.
      Sending through Graph only works for a mailbox Microsoft actually hosts;
      the JS below removes that option for anything else, and the model
      validates the same rule so the API cannot store it either. %>
  <p>
    <label><%= l(:field_helpdesk_reply_transport) %></label>
    <%= select_tag 'helpdesk_mailbox[reply_transport]',
        options_for_select(
          [[l(:label_helpdesk_transport_provider), 'provider'],
           [l(:label_helpdesk_transport_graph),    'graph'],
           [l(:label_helpdesk_transport_smtp),     'smtp']],
          @mailbox.reply_transport.presence || 'graph'
        ),
        :id => 'hd_reply_transport',
        :data => { :label_smtp  => l(:label_helpdesk_transport_mailbox_smtp),
                   :label_graph => l(:label_helpdesk_transport_mailbox_graph),
                   # Both are invisible to the form: the effective preset of a
                   # mailbox on global credentials, and whether a central app
                   # registration exists at all.
                   :global_preset => RedmineExpertHelpdesk::MailboxCredentials.global_preset,
                   :central_graph => RedmineExpertHelpdesk::GraphClient.new.configured? } %>
    <em class="info"><%= l(:text_helpdesk_reply_transport_info) %></em>
  </p>

  <%# Nur fuer den Weg ueber Redmines eigenen Relay: dort ist der Absender ein
      freies Kopffeld. Graph und das eigene SMTP-Postfach authentifizieren sich
      als das Postfach selbst und lehnen einen fremden Absender ab - deshalb
      blendet das JS unten die Zeile fuer diese Wege aus. %>
  <p id="hd_smtp_from_row">
    <label><%= l(:field_helpdesk_smtp_from_address) %></label>
    <%= text_field_tag 'helpdesk_mailbox[smtp_from_address]', @mailbox.smtp_from_address,
                       :size => 40, :id => 'hd_smtp_from_address',
                       :placeholder => @mailbox.mailbox_address %>
    <em class="info"><%= l(:text_helpdesk_smtp_from_address_info) %></em>
  </p>

  <p id="hd_smtp_reply_to_row">
    <%# Id-loser Hidden-Partner traegt den Aus-Wert, wie bei den uebrigen
        Checkboxen dieses Plugins. %>
    <%= hidden_field_tag 'helpdesk_mailbox[smtp_reply_to_mailbox]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[smtp_reply_to_mailbox]', '1',
                      @mailbox.smtp_reply_to_mailbox?,
                      :id => 'hd_smtp_reply_to_mailbox' %>
    <%= label_tag 'hd_smtp_reply_to_mailbox', l(:field_helpdesk_smtp_reply_to_mailbox), :class => 'inline' %>
    <em class="info"><%= l(:text_helpdesk_smtp_reply_to_mailbox_info) %></em>
  </p>
  <p>
    <label></label>
    <button type="button" id="hd_test_connection"><span class="icon icon-checked"><%= hd_icon_label('checked') %><%= l(:label_helpdesk_test_connection) %></span></button>
    <%# inline-block + pre-wrap so a long provider error wraps instead of running
        off the line; the copy button hands over the untruncated text either way. %>
    <span id="hd_conn_status" style="font-size:0.9em;margin-left:6px;display:inline-block;vertical-align:top;max-width:55em;white-space:pre-wrap;word-break:break-word;"></span>
    <button type="button" id="hd_conn_copy" style="display:none;margin-left:6px;font-size:0.85em;vertical-align:top;"><%= l(:button_helpdesk_copy_error) %></button>
  </p>
  <p>
    <label><%= l(:field_helpdesk_source_folder) %></label>
    <input type="text" id="hd_source_folder" name="helpdesk_mailbox[source_folder]"
           value="<%= h(@mailbox.source_folder) %>" size="30"
           class="hd-folder-input" autocomplete="off">
    <button type="button" id="hd_refresh_folders" title="Ordnerliste vom Postfach laden"><span class="icon icon-reload"><%= hd_icon_label('reload') %>Ordner laden</span></button>
    <span id="hd_folder_status" style="font-size:0.9em;margin-left:6px;"></span>
  </p>
  <p>
    <label><%= l(:field_helpdesk_processed_folder) %></label>
    <input type="text" id="hd_processed_folder" name="helpdesk_mailbox[processed_folder]"
           value="<%= h(@mailbox.processed_folder) %>" size="30"
           class="hd-folder-input" autocomplete="off">
    <em class="info"><%= l(:text_helpdesk_processed_folder_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_skipped_folder) %></label>
    <input type="text" id="hd_skipped_folder" name="helpdesk_mailbox[skipped_folder]"
           value="<%= h(@mailbox.skipped_folder) %>" size="30"
           class="hd-folder-input" autocomplete="off">
    <em class="info"><%= l(:text_helpdesk_skipped_folder_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_failed_folder) %></label>
    <input type="text" id="hd_failed_folder" name="helpdesk_mailbox[failed_folder]"
           value="<%= h(@mailbox.failed_folder) %>" size="30"
           class="hd-folder-input" autocomplete="off">
    <em class="info"><%= l(:text_helpdesk_failed_folder_info) %></em>
  </p>
  <%# Nur fuer IMAP-Postfaecher: Graph legt die gesendete Kopie selbst ab. %>
  <p id="hd_sent_folder_row">
    <label><%= l(:field_helpdesk_sent_folder) %></label>
    <input type="text" id="hd_sent_folder" name="helpdesk_mailbox[sent_folder]"
           value="<%= h(@mailbox.sent_folder) %>" size="30"
           class="hd-folder-input" autocomplete="off">
    <em class="info"><%= l(:text_helpdesk_sent_folder_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_enabled) %></label>
    <%# The unchecked-value companion of the checkbox below. It must stay id-less: Rails derives
        an id from the field name, which is the very id the checkbox carries, so without :id => nil
        the page ships two elements with the same id and getElementById finds the hidden one. %>
    <%= hidden_field_tag 'helpdesk_mailbox[enabled]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[enabled]', '1', @mailbox.enabled? %>
  </p>
</div>

<fieldset class="box tabular" id="hd_imap_fieldset">
  <legend><%= l(:label_helpdesk_imap_settings) %></legend>
  <p>
    <label><%= l(:field_helpdesk_oauth_preset) %></label>
    <%= select_tag 'helpdesk_mailbox[oauth_preset]',
        options_for_select([[l(:label_helpdesk_preset_microsoft), 'microsoft'],
                            [l(:label_helpdesk_preset_google),    'google'],
                            [l(:label_helpdesk_preset_generic),   'generic']],
                           @mailbox.oauth_preset.presence || 'microsoft'),
        :id => 'hd_oauth_preset' %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_imap_host) %></label>
    <%= text_field_tag 'helpdesk_mailbox[imap_host]', @mailbox.imap_host, :id => 'hd_imap_host', :size => 40 %>
    <%= l(:field_helpdesk_imap_port) %>
    <%= text_field_tag 'helpdesk_mailbox[imap_port]', @mailbox.imap_port, :id => 'hd_imap_port', :size => 5 %>
    <%= select_tag 'helpdesk_mailbox[imap_security]',
        options_for_select([[l(:label_helpdesk_security_ssl), 'ssl'],
                            [l(:label_helpdesk_security_starttls), 'starttls'],
                            [l(:label_helpdesk_security_plain), 'plain']],
                           @mailbox.imap_security.presence || 'ssl'),
        :id => 'hd_imap_security' %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_imap_username) %></label>
    <%= text_field_tag 'helpdesk_mailbox[imap_username]', @mailbox.imap_username, :size => 40 %>
    <em class="info"><%= l(:text_helpdesk_imap_username_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_imap_verify_ssl) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[imap_verify_ssl]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[imap_verify_ssl]', '1', @mailbox.imap_verify_ssl != false %>
    <em class="info"><%= l(:text_helpdesk_verify_ssl_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_imap_unseen_only) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[imap_unseen_only]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[imap_unseen_only]', '1', @mailbox.imap_unseen_only == true %>
    <em class="info"><%= l(:text_helpdesk_imap_unseen_only_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_imap_timeout) %></label>
    <%= text_field_tag 'helpdesk_mailbox[imap_timeout]', @mailbox.imap_timeout, :size => 5 %>
  </p>
  <p><em class="info"><%= l(:text_helpdesk_gmail_labels_info) %></em></p>
  <p><em class="info"><%= l(:text_helpdesk_expunge_fallback_warning) %></em></p>
</fieldset>

<fieldset class="box tabular" id="hd_smtp_fieldset">
  <legend><%= l(:label_helpdesk_smtp_settings) %></legend>
  <p>
    <label><%= l(:field_helpdesk_smtp_host) %></label>
    <%= text_field_tag 'helpdesk_mailbox[smtp_host]', @mailbox.smtp_host, :id => 'hd_smtp_host', :size => 40 %>
    <%= l(:field_helpdesk_smtp_port) %>
    <%= text_field_tag 'helpdesk_mailbox[smtp_port]', @mailbox.smtp_port, :id => 'hd_smtp_port', :size => 5 %>
    <%= select_tag 'helpdesk_mailbox[smtp_security]',
        options_for_select([[l(:label_helpdesk_security_ssl), 'ssl'],
                            [l(:label_helpdesk_security_starttls), 'starttls'],
                            [l(:label_helpdesk_security_plain), 'plain']],
                           @mailbox.smtp_security.presence || 'starttls'),
        :id => 'hd_smtp_security' %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_smtp_username) %></label>
    <%= text_field_tag 'helpdesk_mailbox[smtp_username]', @mailbox.smtp_username, :size => 40 %>
    <em class="info"><%= l(:text_helpdesk_imap_username_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_smtp_verify_ssl) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[smtp_verify_ssl]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[smtp_verify_ssl]', '1', @mailbox.smtp_verify_ssl != false %>
  </p>
</fieldset>

<fieldset class="box tabular" id="hd_auth_fieldset">
  <legend><%= l(:label_helpdesk_oauth_settings) %></legend>
  <%# Nur bei OAuth2 relevant: ein Passwort gehoert immer zum einzelnen Postfach. %>
  <p id="hd_credentials_source_row">
    <label><%= l(:field_helpdesk_credentials_source) %></label>
    <%= select_tag 'helpdesk_mailbox[credentials_source]',
        options_for_select([[l(:label_helpdesk_credentials_global),  'global'],
                            [l(:label_helpdesk_credentials_mailbox), 'mailbox']],
                           @mailbox.credentials_source.presence || 'global'),
        :id => 'hd_credentials_source' %>
    <em class="info"><%= l(:text_helpdesk_credentials_source_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_auth_method) %></label>
    <%= select_tag 'helpdesk_mailbox[auth_method]',
        options_for_select([[l(:label_helpdesk_auth_oauth2),   'oauth2'],
                            [l(:label_helpdesk_auth_password), 'password']],
                           @mailbox.auth_method.presence || 'oauth2'),
        :id => 'hd_auth_method' %>
    <em class="info"><%= l(:text_helpdesk_auth_password_info) %></em>
  </p>
  <div id="hd_password_block">
    <p>
      <label><%= l(:field_helpdesk_mail_password) %></label>
      <%= password_field_tag 'helpdesk_mailbox[mail_password]', '', :size => 40, :autocomplete => 'new-password' %>
      <em class="info"><%= l(:text_helpdesk_secret_blank_info) %></em>
    </p>
  </div>
  <div id="hd_oauth_block">
    <p>
      <label><%= l(:field_helpdesk_oauth_grant) %></label>
      <%= select_tag 'helpdesk_mailbox[oauth_grant]',
          options_for_select([[l(:label_helpdesk_grant_client_credentials), 'client_credentials'],
                              [l(:label_helpdesk_grant_authorization_code), 'authorization_code'],
                              [l(:label_helpdesk_grant_jwt_bearer),         'jwt_bearer']],
                             @mailbox.oauth_grant.presence || 'client_credentials'),
          :id => 'hd_oauth_grant' %>
    </p>
    <div id="hd_oauth_credentials">
      <p id="hd_oauth_tenant_row">
        <label><%= l(:field_helpdesk_oauth_tenant_id) %></label>
        <%= text_field_tag 'helpdesk_mailbox[oauth_tenant_id]', @mailbox.oauth_tenant_id, :id => 'hd_oauth_tenant_id', :size => 40 %>
      </p>
      <p>
        <label><%= l(:field_helpdesk_oauth_client_id) %></label>
        <%= text_field_tag 'helpdesk_mailbox[oauth_client_id]', @mailbox.oauth_client_id, :size => 40 %>
      </p>
      <p>
        <label><%= l(:field_helpdesk_oauth_client_secret) %></label>
        <%= password_field_tag 'helpdesk_mailbox[oauth_client_secret]', '', :size => 40, :autocomplete => 'new-password' %>
        <em class="info"><%= l(:text_helpdesk_secret_blank_info) %></em>
      </p>
      <%# Microsoft und Google liefern diese drei Werte ueber die Vorlage; nur
          "Andere / selbst gehostet" braucht sie von Hand. %>
      <div id="hd_oauth_urls">
        <p>
          <label><%= l(:field_helpdesk_oauth_authorize_url) %></label>
          <%= text_field_tag 'helpdesk_mailbox[oauth_authorize_url]', @mailbox.oauth_authorize_url, :id => 'hd_oauth_authorize_url', :size => 60 %>
        </p>
        <p>
          <label><%= l(:field_helpdesk_oauth_token_url) %></label>
          <%= text_field_tag 'helpdesk_mailbox[oauth_token_url]', @mailbox.oauth_token_url, :id => 'hd_oauth_token_url', :size => 60 %>
        </p>
        <p>
          <label><%= l(:field_helpdesk_oauth_scope) %></label>
          <%= text_field_tag 'helpdesk_mailbox[oauth_scope]', @mailbox.oauth_scope, :id => 'hd_oauth_scope', :size => 60 %>
          <em class="info"><%= l(:text_helpdesk_default_oauth_urls_info) %></em>
        </p>
      </div>
    </div>
    <div id="hd_oauth_sa_block">
      <p>
        <label><%= l(:field_helpdesk_oauth_sa_email) %></label>
        <%= text_field_tag 'helpdesk_mailbox[oauth_sa_email]', @mailbox.oauth_sa_email, :size => 40 %>
      </p>
      <p>
        <label><%= l(:field_helpdesk_oauth_sa_key) %></label>
        <%= text_area_tag 'helpdesk_mailbox[oauth_sa_key]', '', :rows => 4, :cols => 60 %>
        <em class="info"><%= l(:text_helpdesk_secret_blank_info) %></em>
      </p>
    </div>
    <div id="hd_oauth_consent_block">
      <p>
        <label><%= l(:label_helpdesk_oauth_callback_url) %></label>
        <code><%= ExpertHelpdeskOauthController.callback_url %></code>
        <em class="info"><%= l(:text_helpdesk_oauth_callback_url_info) %></em>
      </p>
      <p>
        <label></label>
        <% if @mailbox.new_record? %>
          <em class="info"><%= l(:label_helpdesk_oauth_not_connected) %></em>
        <% elsif @mailbox.oauth_connected_at.present? %>
          <%= link_to l(:label_helpdesk_oauth_reconnect),
                      oauth_authorize_helpdesk_mailbox_path(:project_id => @project.identifier, :id => @mailbox),
                      :class => 'icon icon-reload' %>
          <em class="info"><%= l(:label_helpdesk_oauth_connected_since, :date => format_time(@mailbox.oauth_connected_at)) %></em>
        <% else %>
          <%= link_to l(:label_helpdesk_oauth_connect),
                      oauth_authorize_helpdesk_mailbox_path(:project_id => @project.identifier, :id => @mailbox),
                      :class => 'icon icon-add' %>
          <em class="info"><%= l(:label_helpdesk_oauth_not_connected) %></em>
        <% end %>
      </p>
    </div>
  </div>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_defaults) %></legend>
  <p>
    <label><%= l(:field_tracker) %></label>
    <%= select_tag 'helpdesk_mailbox[default_tracker_id]',
        options_from_collection_for_select(@project.trackers, :id, :name, @mailbox.default_tracker_id),
        :include_blank => true %>
  </p>
  <p>
    <label><%= l(:field_priority) %></label>
    <%= select_tag 'helpdesk_mailbox[default_priority_id]',
        options_from_collection_for_select(IssuePriority.active, :id, :name, @mailbox.default_priority_id),
        :include_blank => true %>
  </p>
  <p>
    <label><%= l(:field_status) %></label>
    <%= select_tag 'helpdesk_mailbox[default_status_id]',
        options_from_collection_for_select(IssueStatus.sorted, :id, :name, @mailbox.default_status_id),
        :include_blank => true %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_unknown_user_mode) %></label>
    <%= select_tag 'helpdesk_mailbox[unknown_user_mode]',
        options_for_select(HelpdeskMailbox::UNKNOWN_USER_MODES.map { |m| [l("label_helpdesk_unknown_user_#{m}"), m] },
                           @mailbox.unknown_user_mode) %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_suppress_notifications) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[suppress_notifications]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[suppress_notifications]', '1', @mailbox.suppress_notifications? %>
    <em class="info"><%= l(:text_helpdesk_suppress_notifications_info) %></em>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_reopen) %></legend>
  <p>
    <label><%= l(:field_helpdesk_reopen_status) %></label>
    <%= select_tag 'helpdesk_mailbox[reopen_status_id]',
        options_from_collection_for_select(IssueStatus.sorted, :id, :name, @mailbox.reopen_status_id),
        :include_blank => true %>
    <em class="info"><%= l(:text_helpdesk_reopen_status_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_reopen_max_age_days) %></label>
    <%= number_field_tag 'helpdesk_mailbox[reopen_max_age_days]', @mailbox.reopen_max_age_days,
        :min => 1, :size => 6, :style => 'width:5em' %>
    <em class="info"><%= l(:text_helpdesk_reopen_max_age_days_info) %></em>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_filter) %></legend>
  <p>
    <label><%= l(:field_helpdesk_allow_list) %></label>
    <%= text_area_tag 'helpdesk_mailbox[allow_list]', @mailbox.allow_list, :rows => 4, :cols => 50 %>
    <em class="info"><%= l(:text_helpdesk_allow_list_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_deny_list) %></label>
    <%= text_area_tag 'helpdesk_mailbox[deny_list]', @mailbox.deny_list, :rows => 4, :cols => 50 %>
    <em class="info"><%= l(:text_helpdesk_deny_list_info) %></em>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_auto_reply_filter) %></legend>
  <p>
    <label><%= l(:field_helpdesk_auto_reply_filter_enabled) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[auto_reply_filter_enabled]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[auto_reply_filter_enabled]', '1', @mailbox.auto_reply_filter_enabled? %>
    <em class="info"><%= l(:text_helpdesk_auto_reply_filter_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_auto_reply_sender_whitelist) %></label>
    <%= text_area_tag 'helpdesk_mailbox[auto_reply_sender_whitelist]', @mailbox.auto_reply_sender_whitelist,
        :rows => 3, :cols => 50 %>
    <em class="info"><%= l(:text_helpdesk_auto_reply_sender_whitelist_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_auto_reply_header_whitelist) %></label>
    <%= text_area_tag 'helpdesk_mailbox[auto_reply_header_whitelist]', @mailbox.auto_reply_header_whitelist,
        :rows => 3, :cols => 50 %>
    <em class="info"><%= l(:text_helpdesk_auto_reply_header_whitelist_info) %></em>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_autoresponder) %></legend>
  <p>
    <label><%= l(:field_helpdesk_autoresponder_enabled) %></label>
    <%= hidden_field_tag 'helpdesk_mailbox[autoresponder_enabled]', '0', :id => nil %>
    <%= check_box_tag 'helpdesk_mailbox[autoresponder_enabled]', '1', @mailbox.autoresponder_enabled? %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_autoresponder_subject) %></label>
    <%= text_field_tag 'helpdesk_mailbox[autoresponder_subject]', @mailbox.autoresponder_subject, :size => 60 %>
    <%= render :partial => 'helpdesk/macro_chips', :locals => { :field_id => 'helpdesk_mailbox_autoresponder_subject' } %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_autoresponder_body) %></label>
    <%= text_area_tag 'helpdesk_mailbox[autoresponder_body]', @mailbox.autoresponder_body, :rows => 6, :cols => 60 %>
    <%= render :partial => 'helpdesk/macro_chips', :locals => { :field_id => 'helpdesk_mailbox_autoresponder_body' } %>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l(:label_helpdesk_reply_header_footer) %></legend>
  <p>
    <label><%= l(:field_helpdesk_reply_header) %></label>
    <%= text_area_tag 'helpdesk_mailbox[reply_header]', @mailbox.reply_header, :rows => 3, :cols => 60 %>
    <%= render :partial => 'helpdesk/macro_chips', :locals => { :field_id => 'helpdesk_mailbox_reply_header' } %>
  </p>
  <p>
    <label><%= l(:field_helpdesk_footer_mode) %></label>
    <%= select_tag 'helpdesk_mailbox[footer_mode]',
        options_for_select(
          HelpdeskMailbox::FOOTER_MODES.map { |m| [l(:"label_helpdesk_footer_mode_#{m}"), m] },
          @mailbox.footer_mode.presence || 'inherit'
        ) %>
    <em class="info"><%= l(:text_helpdesk_footer_mode_info) %></em>
  </p>
  <p>
    <label><%= l(:field_helpdesk_reply_footer) %></label>
    <%= text_area_tag 'helpdesk_mailbox[reply_footer]', @mailbox.reply_footer, :rows => 3, :cols => 60 %>
    <%= render :partial => 'helpdesk/macro_chips', :locals => { :field_id => 'helpdesk_mailbox_reply_footer' } %>
  </p>
  <p>
    <label><%= l(:label_helpdesk_footer_preview) %></label>
    <span id="hd_footer_preview"
          data-global-footer="<%= h(Setting.plugin_redmine_expert_helpdesk['global_footer'].to_s) %>"
          style="display:inline-block; vertical-align:top; box-sizing:border-box; width:460px; background:#eaf4fd; border:1px solid #a8c8e8; padding:8px; margin:0; white-space:pre-wrap; font-family:monospace; font-size:11px; color:#345;"></span>
    <em class="info"><%= l(:text_helpdesk_footer_preview_info) %></em>
  </p>
</fieldset>

<script>
(function () {
  // Live-Vorschau der effektiven Fusszeile (Kombination aus Postfach-Fusszeile
  // und zentraler Signatur gemaess Fusszeilen-Modus, Makros unrendered).
  var preview    = document.getElementById('hd_footer_preview');
  var modeSelect = document.querySelector('select[name="helpdesk_mailbox[footer_mode]"]');
  var footerArea = document.getElementById('helpdesk_mailbox_reply_footer');
  if (!preview || !modeSelect || !footerArea) return;

  var globalFooter = preview.dataset.globalFooter || '';

  function updatePreview() {
    var local = footerArea.value;
    var text;
    switch (modeSelect.value) {
      case 'override':
        text = local;
        break;
      case 'prepend':
        text = [local, globalFooter].filter(function (s) { return s.trim() !== ''; }).join('\n\n');
        break;
      default: // inherit
        text = globalFooter.trim() !== '' ? globalFooter : local;
    }
    preview.textContent = text.trim() !== '' ? text : '<%= j l(:label_none) %>';
  }

  modeSelect.addEventListener('change', updatePreview);
  footerArea.addEventListener('input', updatePreview);
  updatePreview();
})();
</script>

<script>
(function () {
  var box          = document.getElementById('helpdesk-mailbox-box');
  if (!box) return;

  var foldersUrl   = box.dataset.foldersUrl;
  var createUrl    = box.dataset.createFolderUrl;
  var csrfToken    = box.dataset.csrf;
  var addrInput    = document.getElementById('hd_mailbox_address');
  var sourceInput  = document.getElementById('hd_source_folder');
  var procInput    = document.getElementById('hd_processed_folder');
  var refreshBtn   = document.getElementById('hd_refresh_folders');
  var statusEl     = document.getElementById('hd_folder_status');
  var testUrl      = box.dataset.testConnectionUrl;
  var mailboxId    = box.dataset.mailboxId;
  var presets      = JSON.parse(box.dataset.presets || '{}');
  var providerSel  = document.getElementById('hd_provider');
  var presetSel    = document.getElementById('hd_oauth_preset');
  var authMethodSel = document.getElementById('hd_auth_method');
  var grantSel     = document.getElementById('hd_oauth_grant');
  var imapFs       = document.getElementById('hd_imap_fieldset');
  var smtpFs       = document.getElementById('hd_smtp_fieldset');
  var authFs       = document.getElementById('hd_auth_fieldset');
  var passwordBlock = document.getElementById('hd_password_block');
  var oauthBlock   = document.getElementById('hd_oauth_block');
  var saBlock      = document.getElementById('hd_oauth_sa_block');
  var consentBlock = document.getElementById('hd_oauth_consent_block');
  var sourceSel    = document.getElementById('hd_credentials_source');
  var sourceRow    = document.getElementById('hd_credentials_source_row');
  var transportSel = document.getElementById('hd_reply_transport');
  var sentFolderRow = document.getElementById('hd_sent_folder_row');
  var credentialsBlock = document.getElementById('hd_oauth_credentials');
  var tenantRow    = document.getElementById('hd_oauth_tenant_row');
  var urlsBlock    = document.getElementById('hd_oauth_urls');
  var testBtn      = document.getElementById('hd_test_connection');
  var connStatus   = document.getElementById('hd_conn_status');
  var connCopy     = document.getElementById('hd_conn_copy');
  var connCopyLabel   = <%= raw l(:button_helpdesk_copy_error).to_json %>;
  var connCopiedLabel = <%= raw l(:notice_helpdesk_error_copied).to_json %>;
  var knownFolders = [];

  function setStatus(msg, color) {
    statusEl.textContent = msg;
    statusEl.style.color = color || '#888';
  }

  // Folder comboboxes
  //
  // These were <input list="..."> bound to a <datalist>. The browser draws that
  // popup exactly like its own autofill history, so a real folder from the
  // mailbox was indistinguishable from a previously typed value - and the
  // matching is prefix-only in several browsers. This is a listbox we own.
  //
  // Free text stays valid on purpose: the submit handler further down offers to
  // create a folder that does not exist yet, so the input is never restricted
  // to the known list.
  var combos = [];

  function populateDatalist(names) {
    knownFolders = names;
    combos.forEach(function (c) { if (!c.list.hidden) c.render(); });
  }

  function buildCombo(input) {
    var wrap = document.createElement('span');
    wrap.className = 'hd-combo';
    input.parentNode.insertBefore(wrap, input);
    wrap.appendChild(input);

    var toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'hd-combo-toggle';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Ordnerliste anzeigen');
    // No glyph: the chevron is painted by the input's background, exactly like
    // a Redmine <select>. This button is only the hit area over it.
    wrap.appendChild(toggle);

    var list = document.createElement('ul');
    // Redmine's own autocomplete classes, so the list inherits the theme's
    // border, radius, padding and active colour instead of inventing its own.
    list.className = 'hd-combo-list ui-autocomplete ui-menu ui-widget ui-widget-content';
    list.id = input.id + '_list';
    list.setAttribute('role', 'listbox');
    list.hidden = true;
    wrap.appendChild(list);

    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-expanded', 'false');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-controls', list.id);

    var active = -1;
    // Opening via the toggle or the arrow keys browses the whole list; the
    // current value must not filter it, or the field can never be changed to
    // anything that does not contain what is already in it. Typing filters.
    var filtering = false;

    // jQuery UI puts the styling and the active state on the inner wrapper div,
    // not the <li>, so that is what we query and highlight.
    function options() {
      return Array.prototype.slice.call(list.querySelectorAll('.ui-menu-item-wrapper'));
    }

    function highlight(i) {
      var opts = options();
      if (!opts.length) { active = -1; return; }
      active = (i + opts.length) % opts.length;
      opts.forEach(function (o, n) {
        var on = n === active;
        o.classList.toggle('ui-state-active', on);
        o.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    }

    function addOption(label, value, extraClass) {
      var li = document.createElement('li');
      li.className = 'ui-menu-item' + (extraClass ? ' ' + extraClass : '');
      var div = document.createElement('div');
      div.className = 'ui-menu-item-wrapper';
      div.id = list.id + '_opt' + list.childElementCount;
      div.setAttribute('role', 'option');
      div.setAttribute('aria-selected', 'false');
      div.textContent = label;
      // The label is not the value ("+ \"x\" anlegen" vs "x"), so keep the
      // value with the element for the keyboard path.
      div.dataset.value = value;
      li.appendChild(div);
      // mousedown, not click: blur would close the list before click fires.
      li.addEventListener('mousedown', function (e) {
        e.preventDefault();
        commit(value);
      });
      // Pointer hover should track the same highlight the keyboard uses.
      li.addEventListener('mouseenter', function () {
        highlight(options().indexOf(div));
      });
      list.appendChild(li);
    }

    function render() {
      var typed = input.value.trim();
      var needle = filtering ? typed.toLowerCase() : '';
      list.innerHTML = '';
      active = -1;
      input.removeAttribute('aria-activedescendant');

      // Substring, not prefix: folder trees like "INBOX/Support" are far easier
      // to find by the leaf name than by their full path.
      var matches = knownFolders.filter(function (n) {
        return !needle || n.toLowerCase().indexOf(needle) !== -1;
      });
      matches.forEach(function (n) { addOption(n, n); });

      if (!knownFolders.length) {
        var hint = document.createElement('li');
        hint.className = 'hd-combo-empty';
        hint.textContent = 'Noch keine Ordner geladen – "Ordner laden" verwenden';
        list.appendChild(hint);
      } else if (!matches.length && !typed) {
        var none = document.createElement('li');
        none.className = 'hd-combo-empty';
        none.textContent = 'Keine Ordner vorhanden';
        list.appendChild(none);
      }

      // Only offer creation for something that is genuinely not there yet -
      // compared against what is typed, not against the (possibly empty) filter.
      var exact = knownFolders.some(function (n) { return n.toLowerCase() === typed.toLowerCase(); });
      if (typed && !exact) {
        addOption('+ "' + typed + '" anlegen', typed, 'hd-combo-create');
      }
    }

    // The list is position:fixed, so it has to be placed by hand - see the
    // stylesheet for why it cannot simply be absolute inside the wrapper.
    function place() {
      var r = input.getBoundingClientRect();
      list.style.left = r.left + 'px';
      list.style.top = r.bottom + 'px';
      list.style.minWidth = r.width + 'px';
    }

    function open(browseAll) {
      filtering = !browseAll;
      render();
      list.hidden = false;
      place();
      toggle.setAttribute('aria-expanded', 'true');
      input.setAttribute('aria-expanded', 'true');
    }

    function close() {
      list.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    }

    function commit(value) {
      input.value = value;
      close();
      input.focus();
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    toggle.addEventListener('click', function () {
      if (list.hidden) { open(true); input.focus(); } else { close(); }
    });

    input.addEventListener('input', function () {
      filtering = true;
      if (list.hidden) open(false); else render();
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (list.hidden) open(true);
        highlight(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (list.hidden) open(true);
        highlight(active - 1);
      } else if (e.key === 'Enter') {
        // Only swallow Enter while a suggestion is highlighted, so the key
        // still submits the form the rest of the time.
        if (!list.hidden && active >= 0) {
          e.preventDefault();
          commit(options()[active].dataset.value);
        }
      } else if (e.key === 'Escape') {
        if (!list.hidden) { e.stopPropagation(); close(); }
      } else if (e.key === 'Tab') {
        close();
      }
    });

    input.addEventListener('blur', function () {
      // Deferred so a mousedown on an option still lands.
      window.setTimeout(function () {
        if (!wrap.contains(document.activeElement)) close();
      }, 120);
    });

    // A fixed list does not travel with the page, so close it rather than let
    // it hang over unrelated fields.
    window.addEventListener('scroll', function () { if (!list.hidden) close(); }, true);
    window.addEventListener('resize', function () { if (!list.hidden) place(); });

    return { input: input, list: list, render: render };
  }

  Array.prototype.forEach.call(
    document.querySelectorAll('.hd-folder-input'),
    function (input) { combos.push(buildCombo(input)); }
  );

  // Der komplette Formularzustand wird mitgeschickt, damit der Server den
  // Provider (Graph oder IMAP) samt Verbindungsdaten aufbauen kann, statt einer
  // beliebigen Adresse zu vertrauen.
  function formPayload() {
    var form = box.closest('form');
    var body = form ? new FormData(form) : new FormData();
    // Beim Bearbeiten enthaelt das Formular Rails' verstecktes _method=put.
    // Mitgeschickt wuerde daraus ein PUT auf die Member-Route und damit
    // #update mit id="folders" - also ein 404 statt einer Ordnerliste.
    body.delete('_method');
    if (mailboxId) body.append('id', mailboxId);
    return body;
  }

  function postJson(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken, 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
      body: body
    }).then(function (r) {
      // Ein Fehler-Status liefert oft HTML statt JSON. Den Status durchreichen,
      // statt am Parser zu scheitern - sonst steht ueberall nur "Netzwerkfehler".
      return r.json()
        .catch(function () { return { error: 'HTTP ' + r.status + ' ' + r.statusText }; })
        .then(function (data) { return { ok: r.ok, data: data, statusText: r.statusText }; });
    });
  }

  function loadFolders(address) {
    if (!address) return;
    setStatus('Lade Ordner\u2026', '#888');
    postJson(foldersUrl, formPayload())
      .then(function (res) {
        if (Array.isArray(res.data)) {
          populateDatalist(res.data);
          setStatus(res.data.length + ' Ordner geladen', 'green');
        } else {
          setStatus('Fehler: ' + (res.data.error || 'unbekannt'), 'red');
        }
      })
      .catch(function () { setStatus('Netzwerkfehler', 'red'); });
  }

  function createFolderRequest(address, name) {
    var body = formPayload();
    body.append('folder_name', name);
    return postJson(createUrl, body).then(function (res) {
      if (!res.ok || res.data.error) throw new Error(res.data.error || res.statusText);
      return res.data;
    });
  }

  // Sichtbarkeit der Provider-Abschnitte und Anmeldeblöcke
  function syncVisibility() {
    var isImap = providerSel && providerSel.value === 'imap';
    [imapFs, smtpFs, authFs].forEach(function (el) {
      if (el) el.style.display = isImap ? '' : 'none';
    });
    // Die Transportauswahl haengt am Anbieter und muss auch fuer ein
    // Graph-Postfach stimmen - daher vor dem IMAP-Teil.
    syncTransport(isImap);
    if (!isImap) return;

    var oauth = !authMethodSel || authMethodSel.value === 'oauth2';
    if (passwordBlock) passwordBlock.style.display = oauth ? 'none' : '';
    if (oauthBlock) oauthBlock.style.display = oauth ? '' : 'none';

    var grant = grantSel ? grantSel.value : 'client_credentials';
    if (saBlock) saBlock.style.display = grant === 'jwt_bearer' ? '' : 'none';
    // Der Consent-Block bleibt auch bei globalen Zugangsdaten sichtbar: das
    // Refresh-Token gehört zum Postfach, nicht zur App-Registrierung.
    if (consentBlock) consentBlock.style.display = grant === 'authorization_code' ? '' : 'none';

    // Die Herkunft der Zugangsdaten betrifft nur die App-Registrierung; ein
    // Passwort gehört immer zum einzelnen Postfach.
    if (sourceRow) sourceRow.style.display = oauth ? '' : 'none';

    // Bei "aus den Plugin-Einstellungen" werden die eigenen Felder komplett
    // ignoriert - sie stehen zu lassen, hieße zwei Wahrheiten anzuzeigen.
    var ownCredentials = !sourceSel || sourceSel.value === 'mailbox';
    if (credentialsBlock) credentialsBlock.style.display = ownCredentials ? '' : 'none';

    var preset = presetSel ? presetSel.value : 'microsoft';
    if (tenantRow) tenantRow.style.display = preset === 'microsoft' ? '' : 'none';
    if (urlsBlock) urlsBlock.style.display = preset === 'generic' ? '' : 'none';

    if (sentFolderRow) sentFolderRow.style.display = isImap ? '' : 'none';
  }

  // Graph nur fuer ein Postfach, das Microsoft auch hostet - sonst schickt der
  // Versand ein sendMail an ein Postfach, das dort nicht existiert - und nur,
  // wenn die zentrale App-Registrierung ueberhaupt gepflegt ist; sonst waere es
  // ein Weg, der erst beim Senden scheitert. Spiegelt
  // HelpdeskMailbox#graph_transport_available?.
  function syncTransport(isImap) {
    if (!transportSel) return;

    // Bei Zugangsdaten aus den Plugin-Einstellungen zaehlt deren Vorlage, nicht
    // das dann ausgeblendete Feld am Postfach.
    var ownCredentials  = sourceSel && sourceSel.value === 'mailbox';
    var preset          = (ownCredentials && presetSel) ? presetSel.value
                                                        : transportSel.dataset.globalPreset;
    var centralGraph    = transportSel.dataset.centralGraph === 'true';
    var microsoftHosted = !isImap || (preset === 'microsoft' && centralGraph);
    var graphOption = transportSel.querySelector('option[value="graph"]');
    if (graphOption) {
      graphOption.hidden   = !microsoftHosted;
      graphOption.disabled = !microsoftHosted;
      // Eine unerlaubte Auswahl still stehen zu lassen, hiesse den Fehler bis
      // zum Speichern zu verstecken.
      if (!microsoftHosted && transportSel.value === 'graph') transportSel.value = 'provider';
    }

    // Das eigene Backend heisst je nach Anbieter anders; "Provider" sagt niemandem etwas.
    var own = transportSel.querySelector('option[value="provider"]');
    if (own) {
      own.textContent = isImap ? transportSel.dataset.labelSmtp : transportSel.dataset.labelGraph;
    }

    // Absender-Override gilt ausschliesslich fuer Redmines eigenen Relay.
    var isRedmineSmtp = transportSel.value === 'smtp';
    var fromRow = document.getElementById('hd_smtp_from_row');
    if (fromRow) fromRow.style.display = isRedmineSmtp ? '' : 'none';
    // Reply-To haengt am Override: ohne abweichenden Absender gibt es nichts
    // umzubiegen, die Option waere dort nur verwirrend.
    var replyRow = document.getElementById('hd_smtp_reply_to_row');
    var fromInput = document.getElementById('hd_smtp_from_address');
    if (replyRow) {
      replyRow.style.display = (isRedmineSmtp && fromInput && fromInput.value.trim() !== '') ? '' : 'none';
    }
  }

  // Vorlage füllt ausschließlich leere Felder - eingetragene Werte bleiben stehen.
  function applyPreset() {
    if (!presetSel || !presets) return;
    var preset = presets[presetSel.value];
    if (!preset) return;

    var tenant = (document.getElementById('hd_oauth_tenant_id') || {}).value || 'common';
    var grant = grantSel ? grantSel.value : 'client_credentials';
    var scopes = preset.scopes || {};

    var pairs = [
      ['hd_imap_host', preset.imap_host], ['hd_imap_port', preset.imap_port],
      ['hd_imap_security', preset.imap_security],
      ['hd_smtp_host', preset.smtp_host], ['hd_smtp_port', preset.smtp_port],
      ['hd_smtp_security', preset.smtp_security],
      ['hd_oauth_authorize_url', (preset.authorize_url || '').replace('{tenant}', tenant)],
      ['hd_oauth_token_url', (preset.token_url || '').replace('{tenant}', tenant)],
      ['hd_oauth_scope', scopes[grant] || '']
    ];

    pairs.forEach(function (pair) {
      var el = document.getElementById(pair[0]);
      if (el && !String(el.value || '').trim() && pair[1]) el.value = pair[1];
    });
  }

  syncVisibility();
  // transportSel gehoert dazu: die Absender-Zeile haengt allein an seinem Wert,
  // ohne ihn wuerde sie erst beim Aendern eines anderen Feldes umschalten.
  [providerSel, authMethodSel, grantSel, sourceSel, presetSel, transportSel].forEach(function (el) {
    if (el) el.addEventListener('change', syncVisibility);
  });
  // Die Reply-To-Zeile haengt am Inhalt des Absender-Feldes, nicht nur an einer Auswahl.
  var smtpFromInput = document.getElementById('hd_smtp_from_address');
  if (smtpFromInput) smtpFromInput.addEventListener('input', syncVisibility);
  if (presetSel) presetSel.addEventListener('change', applyPreset);
  if (grantSel) grantSel.addEventListener('change', applyPreset);
  if (providerSel) {
    providerSel.addEventListener('change', function () {
      if (this.value === 'imap') applyPreset();
    });
  }

  // The full text last shown, so the copy button can hand over the whole
  // provider error even when the status line wrapped or was cut short.
  var connStatusFull = '';

  function showConnStatus(text, color) {
    connStatusFull = text || '';
    connStatus.textContent = connStatusFull;
    connStatus.style.color = color;
    if (connCopy) {
      connCopy.style.display = connStatusFull ? '' : 'none';
      connCopy.textContent = connCopyLabel;
    }
  }

  // navigator.clipboard requires a secure context, which an internal Redmine
  // served over plain http does not have - so fall back to the selection trick
  // instead of failing silently on exactly the installations that need this.
  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function (resolve, reject) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-1000px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      if (ok) { resolve(); } else { reject(new Error('copy unavailable')); }
    });
  }

  if (connCopy) {
    connCopy.addEventListener('click', function () {
      copyText(connStatusFull).then(function () {
        connCopy.textContent = connCopiedLabel;
        setTimeout(function () { connCopy.textContent = connCopyLabel; }, 2000);
      }).catch(function () {
        // Cannot copy - select the text instead so it can be copied by hand.
        var range = document.createRange();
        range.selectNodeContents(connStatus);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
      });
    });
  }

  if (testBtn) {
    testBtn.addEventListener('click', function () {
      showConnStatus('\u2026', '#888');
      if (connCopy) connCopy.style.display = 'none';
      postJson(testUrl, formPayload())
        .then(function (res) {
          var text = res.data.message || (res.data.ok ? 'OK' : '');
          // Den erkannten Gesendet-Ordner mitzeigen: ein falscher Treffer faellt
          // sonst erst nach der ersten Antwort im Log auf.
          if (res.data.ok && res.data.sent_folder) {
            text += ' – ' + res.data.sent_folder;
          }
          showConnStatus(text, res.data.ok ? 'green' : 'red');
          if (res.data.ok && Array.isArray(res.data.folders)) populateDatalist(res.data.folders);
        })
        .catch(function () {
          showConnStatus('Netzwerkfehler', 'red');
        });
    });
  }

  // Ordner laden sobald Adresse vorhanden (z. B. beim Bearbeiten)
  if (addrInput && addrInput.value.trim()) {
    loadFolders(addrInput.value.trim());
  }

  // Ordner neu laden wenn Postfachadresse geaendert wird
  if (addrInput) {
    addrInput.addEventListener('change', function () {
      loadFolders(this.value.trim());
    });
  }

  // Refresh-Button
  if (refreshBtn) {
    refreshBtn.addEventListener('click', function () {
      loadFolders(addrInput ? addrInput.value.trim() : '');
    });
  }

  // Beim Absenden: fehlende Ordner anlegen
  var form = box.closest('form');
  if (form) {
    form.addEventListener('submit', function (e) {
      var address = addrInput ? addrInput.value.trim() : '';
      if (!address || knownFolders.length === 0) return;

      var toCreate = [sourceInput, procInput].reduce(function (acc, inp) {
        if (!inp) return acc;
        var val = inp.value.trim();
        if (val && !knownFolders.includes(val)) acc.push(val);
        return acc;
      }, []);

      if (toCreate.length === 0) return;

      e.preventDefault();
      var names = toCreate.map(function (n) { return '\u201e' + n + '\u201c'; }).join(', ');
      if (!confirm('Die Ordner ' + names + ' existieren noch nicht. Jetzt im Postfach anlegen?')) return;

      setStatus('Erstelle Ordner\u2026', '#888');
      toCreate.reduce(function (chain, name) {
        return chain.then(function () { return createFolderRequest(address, name); });
      }, Promise.resolve())
        .then(function () { form.submit(); })
        .catch(function (err) {
          setStatus('Fehler: ' + err.message, 'red');
          alert('Ordner konnte nicht erstellt werden:\n' + err.message);
        });
    });
  }
})();
</script>
