<%# Kundenliste des Projekts %>
<h2><%= l(:label_helpdesk_customers) %></h2>

<div style="float:right; color:#666; font-size:0.9em; margin-bottom:0.5em;">
  <%= l(:label_helpdesk_contacts_per_page) %>:
  <% [10, 25, 50, 100].each do |n| %>
    &nbsp;<% if @per_page == n %>
      <strong><%= n %></strong>
    <% else %>
      <%= link_to n, helpdesk_contacts_path(:project_id => @project, :per_page => n, :search => @search.presence, :sort => params[:sort].presence) %>
    <% end %>
  <% end %>
</div>

<%= form_tag helpdesk_contacts_path(:project_id => @project), :method => :get, :style => 'margin-bottom:0.8em;' do %>
  <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
  <%= text_field_tag :search, @search, :size => 30, :placeholder => l(:label_helpdesk_contact_search) %>
  <%= submit_tag l(:button_apply), :name => nil %>
  <% if @search.present? %>
    <%= link_to l(:button_clear), helpdesk_contacts_path(:project_id => @project) %>
  <% end %>
<% end %>

<% if @contact_count > 0 %>
  <table class="list">
    <thead>
      <tr>
        <%= sort_header_tag('name', :caption => l(:field_name)) %>
        <%= sort_header_tag('email', :caption => l(:label_helpdesk_email)) %>
        <%= sort_header_tag('company', :caption => l(:label_helpdesk_company)) %>
        <%= sort_header_tag('phone', :caption => l(:label_helpdesk_phone)) %>
        <%= sort_header_tag('ticket_count', :caption => l(:label_helpdesk_ticket_count), :default_order => 'desc') %>
        <%= sort_header_tag('last_ticket', :caption => l(:label_helpdesk_last_ticket), :default_order => 'desc') %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @contacts.each do |contact| %>
        <%
          msgs      = contact.helpdesk_messages
          issue_ids = msgs.map(&:issue_id).uniq
          last_msg  = msgs.max_by(&:sent_at)
        %>
        <tr>
          <td><strong><%= link_to contact.display_name,
              edit_helpdesk_contact_path(contact, :project_id => @project) %></strong>
            <%# Marked as "never ask": shown as a tag rather than an own column, so the
                sortable header row and the notes colspan stay as they are. %>
            <% if contact.info_request_opt_out? %>
              <span class="hd-contact-tag"
                    title="<%= h(l(:text_helpdesk_contact_info_request_opt_out_info)) %>"><%=
                l(:label_helpdesk_contact_info_request_opt_out_short) %></span>
            <% end %>
          </td>
          <td><%= mail_to contact.email %></td>
          <td><%= contact.company.presence || '–' %></td>
          <td><%= contact.phone.presence    || '–' %></td>
          <td>
            <% issues_url = project_issues_path(@project,
                 :set_filter => 1,
                 :f          => ['helpdesk_kunde'],
                 :op         => { :helpdesk_kunde => '=' },
                 :v          => { :helpdesk_kunde => [contact.email] }) %>
            <%= link_to issue_ids.size, issues_url %>
          </td>
          <td>
            <% if last_msg&.sent_at %>
              <%= format_date(last_msg.sent_at) %>
            <% else %>
              –
            <% end %>
          </td>
          <td class="buttons">
            <%= link_to hd_icon_label('edit', l(:button_edit)),
                edit_helpdesk_contact_path(contact, :project_id => @project),
                :class => 'icon icon-edit' %>
            <%= link_to hd_icon_label('del', l(:button_delete)),
                helpdesk_contact_path(contact, :project_id => @project),
                :method => :delete,
                :data   => { :confirm => l(:text_are_you_sure) },
                :class  => 'icon icon-del' %>
          </td>
        </tr>
        <% if contact.notes.present? %>
          <tr>
            <td colspan="7" style="padding-left:1.5em; color:#555; font-size:0.9em;">
              <%= contact.notes %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <span class="pagination"><%= pagination_links_full @contact_pages, @contact_count %></span>

<style>
  .hd-contact-tag {
    display: inline-block;
    font-size: 0.85em;
    font-weight: normal;
    padding: 0 5px;
    line-height: 1.5;
    border-radius: 3px;
    background: #f3e5c3;
    color: #7a5c00;
    border: 1px solid #e0cc98;
    cursor: default;
  }
</style>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
