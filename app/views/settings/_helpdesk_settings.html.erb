      <%= text_field_tag 'settings[default_oauth_authorize_url]', @settings['default_oauth_authorize_url'], :size => 70 %>
    </p>
    <p>
      <label><%= l(:field_helpdesk_oauth_token_url) %></label>
      <%= text_field_tag 'settings[default_oauth_token_url]', @settings['default_oauth_token_url'], :size => 70 %>
    </p>
    <p>
      <label><%= l(:field_helpdesk_oauth_scope) %></label>
      <%= text_field_tag 'settings[default_oauth_scope]', @settings['default_oauth_scope'], :size => 70 %>
      <em class="info"><%= l(:text_helpdesk_default_oauth_urls_info) %></em>
    </p>
  </div>

  <%# Nur das Verfahren "Einmalige Zustimmung" fuehrt ueber eine Redirect-URI. %>
  <div id="hd_s_consent_block">
    <p>
      <label><%= l(:label_helpdesk_oauth_callback_url) %></label>
      <code><%= ExpertHelpdeskOauthController.callback_url %></code>
