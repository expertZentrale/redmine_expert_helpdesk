    <em class="info"><%= l(:text_helpdesk_global_app_registration_info) %></em>
  </p>

  <%# Vorlagen fuer Microsoft/Google liefern Hosts und URLs selbst; nur bei
      "Andere / selbst gehostet" muss der Betreiber sie angeben. %>
  <div id="hd_s_generic_block">
    <p>
      <label><%= l(:field_helpdesk_imap_host) %></label>
