<script type="text/javascript">
//<![CDATA[
// Blendet die Felder aus, die die gewaehlte Vorlage bzw. das Verfahren selbst
// liefert - so bleibt genau das stehen, was der Betreiber eintragen muss.
(function () {
  var presetSel = document.getElementById('hd_s_preset');
  var grantSel  = document.getElementById('hd_s_grant');
  if (!presetSel || !grantSel) return;

  function show(id, visible) {
    var el = document.getElementById(id);
    if (el) el.style.display = visible ? '' : 'none';
  }

  function sync() {
    var preset = presetSel.value;
    var grant  = grantSel.value;
    show('hd_s_tenant_row',     preset === 'microsoft');
    show('hd_s_generic_block',  preset === 'generic');
    show('hd_s_consent_block',  grant === 'authorization_code');
    show('hd_s_azure_hints',    preset === 'microsoft');
  }

  sync();
  presetSel.addEventListener('change', sync);
  grantSel.addEventListener('change', sync);
}());
//]]>
</script>

