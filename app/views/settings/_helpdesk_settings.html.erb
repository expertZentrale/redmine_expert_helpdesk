  <%= text_field_tag 'settings[phishtank_feed_url]',
                     @settings['phishtank_feed_url'].presence || RedmineExpertHelpdesk::PhishtankSync::DEFAULT_FEED_URL,
                     :size => 70 %>
  <em class="info"><%= l(:text_helpdesk_phishtank_feed_url_info) %></em>
</p>
<p>
  <label><%= l(:field_helpdesk_phishtank_interval_hours) %></label>
  <%= text_field_tag 'settings[phishtank_interval_hours]', @settings['phishtank_interval_hours'].presence || '6', :size => 5 %>
  <em class="info"><%= l(:text_helpdesk_phishtank_interval_info) %></em>
</p>
<p>
  <%= hidden_field_tag 'settings[phishing_database_enabled]', '0' %>
  <%= check_box_tag 'settings[phishing_database_enabled]', '1', @settings['phishing_database_enabled'] == '1',
                    :id => 'settings_phishing_database_enabled' %>
  <%= label_tag 'settings_phishing_database_enabled', l(:field_helpdesk_phishing_database_enabled) %>
  <em class="info"><%= l(:text_helpdesk_phishing_database_info) %></em>
</p>
<p>
  <label><%= l(:field_helpdesk_phishing_database_feed_url) %></label>
  <%= text_field_tag 'settings[phishing_database_feed_url]',
                     @settings['phishing_database_feed_url'].presence || RedmineExpertHelpdesk::PhishingDatabaseSync::DEFAULT_FEED_URL,
                     :size => 70 %>
</p>
<p>
  <% counts  = HelpdeskPhishingUrl.group(:source).count %>
  <% imports = HelpdeskPhishingUrl.group(:source).maximum(:imported_at) %>
  <% HelpdeskPhishingUrl::SOURCES.each do |source| %>
    <em class="info">
      <%= l(:text_helpdesk_phishing_source_status,
            :source => source,
            :count => counts[source] || 0,
            :last_import => imports[source] ? format_time(imports[source]) : '–') %>
    </em><br />
  <% end %>
</p>
<p>
  <%= link_to hd_icon_label('reload', l(:button_helpdesk_phishtank_sync)), helpdesk_phishtank_sync_path,
              :method => :post, :class => 'icon icon-reload',
              :data => { :confirm => l(:text_helpdesk_phishtank_sync_confirm) } %>
</p>

<% legacy_available = RedmineExpertHelpdesk::LegacyContactsImport.available? %>
<% misplaced_count  = RedmineExpertHelpdesk::LegacyContactsImport.misplaced_attachment_count %>
<% if legacy_available || misplaced_count > 0 %>
  <hr />
  <h3 style="margin-top:1em;"><%= l(:label_helpdesk_legacy_import) %></h3>
  <% if legacy_available %>
    <p>
      <em class="info">
        <%= l(:text_helpdesk_legacy_import_info,
              :count => RedmineExpertHelpdesk::LegacyContactsImport.legacy_contact_count) %>
      </em>
    </p>
    <p>
      <%= link_to hd_icon_label('reload', l(:button_helpdesk_legacy_import)), helpdesk_legacy_import_select_path,
                  :class => 'icon icon-reload' %>
    </p>
  <% end %>
  <% if misplaced_count > 0 %>
    <p>
      <em class="info"><%= l(:text_helpdesk_legacy_fix_info, :count => misplaced_count) %></em>
    </p>
    <p>
      <%= link_to hd_icon_label('attachment', l(:button_helpdesk_legacy_fix)), helpdesk_legacy_fix_attachments_path,
                  :method => :post, :class => 'icon icon-attachment',
                  :data => { :confirm => l(:text_helpdesk_legacy_fix_confirm) } %>
    </p>
  <% end %>
<% end %>
