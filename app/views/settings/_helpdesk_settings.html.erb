            :source => source,
            :count => counts[source] || 0,
            :last_import => imports[source] ? format_time(imports[source]) : '–') %>
    </em><br />
  <% end %>
</p>
<p>
  <%= link_to hd_icon_label('reload', l(:button_helpdesk_phishtank_sync)), helpdesk_phishtank_sync_path,
              :method => :post, :class => 'icon icon-reload',
              :data => { :confirm => l(:text_helpdesk_phishtank_sync_confirm) } %>
</p>

<% legacy_available = RedmineExpertHelpdesk::LegacyContactsImport.available? %>
<% misplaced_count  = RedmineExpertHelpdesk::LegacyContactsImport.misplaced_attachment_count %>
<% if legacy_available || misplaced_count > 0 %>
  <hr />
  <h3 style="margin-top:1em;"><%= l(:label_helpdesk_legacy_import) %></h3>
  <% if legacy_available %>
    <p>
      <em class="info">
        <%= l(:text_helpdesk_legacy_import_info,
              :count => RedmineExpertHelpdesk::LegacyContactsImport.legacy_contact_count) %>
      </em>
    </p>
    <p>
      <%= link_to hd_icon_label('reload', l(:button_helpdesk_legacy_import)), helpdesk_legacy_import_select_path,
                  :class => 'icon icon-reload' %>
    </p>
  <% end %>
  <% if misplaced_count > 0 %>
    <p>
      <em class="info"><%= l(:text_helpdesk_legacy_fix_info, :count => misplaced_count) %></em>
    </p>
    <p>
      <%= link_to hd_icon_label('attachment', l(:button_helpdesk_legacy_fix)), helpdesk_legacy_fix_attachments_path,
                  :method => :post, :class => 'icon icon-attachment',
                  :data => { :confirm => l(:text_helpdesk_legacy_fix_confirm) } %>
    </p>
  <% end %>
<% end %>
