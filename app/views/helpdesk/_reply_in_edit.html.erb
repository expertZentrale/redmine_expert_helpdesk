<%# Antwort-an-Kunden-Block im normalen Ticket-Bearbeitungsformular.
    Wird via view_issues_edit_notes_bottom-Hook eingebunden.
    Verwendet Redmines eigenes Notizfeld (issue_notes) als E-Mail-Inhalt.
    Beim Absenden wird die Mail zuerst per fetch() (JSON) gesendet,
    dann wird das Formular normal abgesendet (Notiz → Journal). %>
<div id="hd-reply-section">
  <div id="hd-send-error" style="display:none;"></div>
  <label class="hd-send-label">
    <%= check_box_tag 'hd_send_mail', '1', send_by_default, :id => 'hd-send-mail-cb' %>
    <strong><%= l(:label_helpdesk_send_as_mail) %></strong>
    &mdash;
    <%= h(contact.display_name) %>
    &lt;<a href="mailto:<%= h(contact.email) %>"><%= h(contact.email) %></a>&gt;
  </label>

  <div id="hd-mail-extra" style="<%= send_by_default ? '' : 'display:none;' %> margin-top: 8px;">
    <table class="hd-fields-table">
      <tr>
        <th><%= l(:label_helpdesk_reply_to) %></th>
        <td>
          <input type="text" id="hd-to"  value="<%= h(contact.email) %>" class="hd-addr-field" />
        </td>
      </tr>
      <tr>
        <th>CC</th>
        <td>
          <input type="text" id="hd-cc"  value="" class="hd-addr-field"
                 placeholder="<%= h(l(:label_helpdesk_reply_addresses_hint)) %>" />
        </td>
      </tr>
      <tr>
        <th>BCC</th>
        <td>
          <input type="text" id="hd-bcc" value="" class="hd-addr-field"
                 placeholder="<%= h(l(:label_helpdesk_reply_addresses_hint)) %>" />
        </td>
      </tr>
      <% if issue.attachments.any? %>
      <tr>
        <th style="vertical-align: top; padding-top: 5px;"><%= l(:label_helpdesk_reply_attachments) %></th>
        <td>
          <div id="hd-attachments-list">
            <% issue.attachments.each do |att| %>
              <label class="hd-att-label">
                <input type="checkbox" class="hd-att-cb" value="<%= att.id %>" />
                <%= h(att.filename) %>
                <span class="hd-att-size">(<%= number_to_human_size(att.filesize) %>)</span>
              </label>
            <% end %>
          </div>
        </td>
      </tr>
      <% end %>
    </table>
    <% if footer_text.present? %>
      <div class="hd-footer-preview">
        <span class="hd-footer-label"><%= l(:label_helpdesk_mail_footer_preview) %></span>
        <div class="hd-footer-content"><%= simple_format(h(footer_text)) %></div>
      </div>
    <% end %>
  </div>
</div>

<style>
#hd-send-error {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: #fdecea;
  border: 1px solid #e57373;
  border-left: 4px solid #c0392b;
  border-radius: 3px;
  padding: 10px 14px;
  margin-bottom: 10px;
  font-size: 0.95em;
  color: #7f1313;
  line-height: 1.4;
}
#hd-send-error .hd-err-icon {
  font-size: 1.2em;
  flex-shrink: 0;
  margin-top: 1px;
}
#hd-send-error .hd-err-text { flex: 1; }
#hd-send-error .hd-err-close {
  cursor: pointer;
  font-size: 1.1em;
  color: #c0392b;
  background: none;
  border: none;
  padding: 0 2px;
  line-height: 1;
  flex-shrink: 0;
}
#hd-reply-section {
  margin-top: 10px;
  padding: 8px 12px;
  background: #edf2fa;
  border: 1px solid #c8d8ec;
  border-radius: 3px;
}
.hd-send-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.95em;
  cursor: pointer;
  user-select: none;
}
.hd-send-label input[type=checkbox] { margin: 0; }
.hd-send-label a { color: inherit; }
.hd-fields-table { border-collapse: collapse; }
.hd-fields-table th {
  font-weight: normal;
  text-align: right;
  padding: 3px 8px 3px 0;
  width: 3.5em;
  color: #555;
  white-space: nowrap;
  vertical-align: middle;
}
.hd-fields-table td { padding: 2px 0; }
.hd-addr-field {
  width: 420px;
  max-width: 100%;
  padding: 2px 5px;
  border: 1px solid #bbb;
  border-radius: 2px;
  font-size: 0.9em;
}
.hd-footer-preview {
  margin-top: 10px;
  padding: 6px 10px;
  background: #f4f7fb;
  border-left: 3px solid #c8d8ec;
  font-size: 0.85em;
  color: #555;
}
.hd-footer-label {
  font-weight: bold;
  display: block;
  margin-bottom: 3px;
  color: #7a8ea8;
  font-size: 0.85em;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
#hd-attachments-list {
  max-height: 110px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hd-att-label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.9em;
  cursor: pointer;
}
.hd-att-size { color: #888; font-size: 0.85em; }
.hd-footer-content p { margin: 2px 0; }
.hd-ac-wrap { position: relative; display: inline-block; }
.hd-ac-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  z-index: 9999;
  background: #fff;
  border: 1px solid #aaa;
  border-top: none;
  border-radius: 0 0 3px 3px;
  min-width: 300px;
  max-width: 480px;
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
  list-style: none;
  margin: 0;
  padding: 0;
}
.hd-ac-dropdown li {
  padding: 5px 10px;
  cursor: pointer;
  font-size: 0.88em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #333;
}
.hd-ac-dropdown li:hover,
.hd-ac-dropdown li.hd-ac-active { background: #e8f0fc; }
</style>

<script>
//<![CDATA[
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    var cb        = document.getElementById('hd-send-mail-cb');
    var extra     = document.getElementById('hd-mail-extra');
    var issueForm = document.getElementById('issue-form');
    if (!cb || !extra || !issueForm) return;

    // Reply-Button auch im Edit-Formular einfuegen (falls noch nicht vorhanden)
    (function() {
      if (document.getElementById('hd-reply-link')) return;
      var contextual = document.querySelector('#content > div.contextual');
      if (!contextual) return;
      var link = document.createElement('a');
      link.id        = 'hd-reply-link';
      link.href      = '#';
      link.className = 'icon icon-email hd-reply-btn';
      link.textContent = '<%= j(l(:button_helpdesk_reply)) %>';
      if (window.hdSpriteIcon) { link.insertAdjacentHTML('afterbegin', window.hdSpriteIcon('email')); }
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (cb && !cb.checked) { cb.checked = true; cb.dispatchEvent(new Event('change')); }
        var section = document.getElementById('hd-reply-section');
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      contextual.insertBefore(link, contextual.firstChild);
    })();

    // Reply-Button zusaetzlich in die untere Kontextleiste (unter dem Verlauf) einfuegen,
    // damit man nach dem Durchlesen des Verlaufs nicht nach oben scrollen muss. Redmine 6
    // rendert eine zweite div.contextual am Seitenende — dort inline einreihen, genau wie
    // oben, statt eine separate Leiste zu bauen.
    (function() {
      if (document.getElementById('hd-reply-link-bottom')) return;
      var bars = document.querySelectorAll('#content > div.contextual');
      // Letzte Kontextleiste = die untere; nur wenn sie nicht die obere (mit #hd-reply-link) ist.
      var contextual = bars.length ? bars[bars.length - 1] : null;
      if (!contextual || contextual.querySelector('#hd-reply-link')) return;
      var link = document.createElement('a');
      link.id        = 'hd-reply-link-bottom';
      link.href      = '#';
      link.className = 'icon icon-email hd-reply-btn';
      link.textContent = '<%= j(l(:button_helpdesk_reply)) %>';
      if (window.hdSpriteIcon) { link.insertAdjacentHTML('afterbegin', window.hdSpriteIcon('email')); }
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof showAndScrollTo === 'function') { showAndScrollTo('update', 'hd-send-mail-cb'); }
        if (cb && !cb.checked) { cb.checked = true; cb.dispatchEvent(new Event('change')); }
        if (extra) { extra.style.display = ''; }
        var section = document.getElementById('hd-reply-section');
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      contextual.insertBefore(link, contextual.firstChild);
    })();

    // Panel vor den Notes-Editor verschieben
    (function() {
      var section  = document.getElementById('hd-reply-section');
      var addNotes = document.getElementById('add_notes');
      var jstBlock = addNotes && addNotes.querySelector('.jstBlock');
      if (section && jstBlock && jstBlock.parentNode) {
        jstBlock.parentNode.insertBefore(section, jstBlock);
      } else if (section && addNotes) {
        // Fallback: ans Anfang des Fieldsets
        var legend = addNotes.querySelector('legend');
        if (legend && legend.nextSibling) {
          addNotes.insertBefore(section, legend.nextSibling);
        }
      }
    })();

    // Auto-Aktivierung wenn per Reply-Button navigiert wurde
    if (new URLSearchParams(window.location.search).get('hd_reply') === '1') {
      if (!cb.checked) { cb.checked = true; }
      extra.style.display = ''; // direkt setzen, nicht via Event (Listener noch nicht registriert)
      var section = document.getElementById('hd-reply-section');
      if (section) setTimeout(function() { section.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 150);
    }

    // Sichtbarkeit der Empfaengerfelder umschalten; Fehler-Banner zuruecksetzen
    cb.addEventListener('change', function() {
      extra.style.display = this.checked ? '' : 'none';
      var errBox = document.getElementById('hd-send-error');
      if (errBox) errBox.style.display = 'none';
    });

    // Form-Submit: erst Mail senden, dann normaler Redmine-Submit (Notiz → Journal)
    issueForm.addEventListener('submit', function(e) {
      if (!cb.checked) return; // kein Haken → normaler Submit ohne Mail

      var notesEl     = document.getElementById('issue_notes');
      var noteContent = notesEl ? notesEl.value.trim() : '';

      if (noteContent === '') {
        e.preventDefault();
        alert('<%= j(l(:error_helpdesk_empty_reply)) %>');
        return;
      }

      e.preventDefault();

      var toVal  = document.getElementById('hd-to').value.trim().replace(/[\s,;]+$/, '');
      var ccVal  = document.getElementById('hd-cc').value.trim().replace(/[\s,;]+$/, '');
      var bccVal = document.getElementById('hd-bcc').value.trim().replace(/[\s,;]+$/, '');

      var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var formData  = new FormData();
      formData.append('note_content', noteContent);
      formData.append('reply_to',     toVal);
      formData.append('reply_cc',     ccVal);
      formData.append('reply_bcc',    bccVal);

      document.querySelectorAll('#hd-attachments-list .hd-att-cb:checked').forEach(function(attCb) {
        formData.append('attachment_ids[]', attCb.value);
      });

      // Eingefuegte / per Drag-Drop hochgeladene Bilder (pending attachments) per Token anfuegen
      // Selektor: nur versteckte [token]-Inputs; Wert = echter Token-String ("ID.DIGEST")
      var seenTokens = {};
      issueForm.querySelectorAll('input[type="hidden"][name^="attachments["][name$="][token]"]').forEach(function(inp) {
        var token = inp.value;
        if (token && !seenTokens[token]) {
          seenTokens[token] = true;
          formData.append('inline_attachment_tokens[]', token);
        }
      });

      fetch('<%= j(issue_helpdesk_reply_path(issue)) %>', {
        method:  'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body:    formData
      }).then(function(resp) {
        return resp.json().then(function(data) {
          if (!resp.ok) throw new Error(data.error || resp.statusText);
          return data;
        });
      }).then(function(data) {
        cb.checked = false;

        // Message-ID als Hidden-Field mitschicken: der Server verknuepft damit
        // das entstehende Journal mit der versendeten Mail (kein Timestamp-Matching)
        if (data.helpdesk_message_id) {
          var idInput = document.createElement('input');
          idInput.type  = 'hidden';
          idInput.name  = 'hd_sent_message_id';
          idInput.value = data.helpdesk_message_id;
          issueForm.appendChild(idInput);
        }

        // Status und Bearbeiter automatisch setzen (aus Projekteinstellungen)
        <% if reply_status_id.present? %>
        var statusSel = issueForm.querySelector('select[name="issue[status_id]"]');
        if (statusSel) statusSel.value = '<%= reply_status_id.to_i %>';
        <% end %>
        <% if reply_assign_to_sender %>
        // Claim the ticket only while it is still unassigned - neither stored
        // (user or group) nor just picked in this form.
        var assignSel = issueForm.querySelector('select[name="issue[assigned_to_id]"]');
        if (assignSel && !assignSel.value) assignSel.value = '<%= User.current.id %>';
        <% end %>

        issueForm.submit(); // normaler Submit, bypasses event listener
      }).catch(function(err) {
        // Submit-Buttons wieder aktivieren, damit das Formular weiter nutzbar bleibt
        issueForm.querySelectorAll('[type=submit]').forEach(function(btn) {
          btn.disabled = false;
        });
        var errBox = document.getElementById('hd-send-error');
        errBox.innerHTML = '<span class="hd-err-icon">&#9888;</span>' +
                           '<span class="hd-err-text"><strong><%= j(l(:error_helpdesk_reply_failed, :message => "")) %></strong>' +
                           err.message + '</span>' +
                           '<button class="hd-err-close" onclick="this.parentNode.style.display=\'none\'" title="Schlie&szlig;en">&times;</button>';
        errBox.style.display = 'flex';
        errBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  });
})();

// Autocomplete fuer Adressfelder (To / CC / BCC): Kontaktsuche per Tipp
(function() {
  var AC_URL      = '<%= j(autocomplete_helpdesk_contacts_path(:project_id => project)) %>';
  var DEBOUNCE_MS = 250;
  var cache       = {};

  function setupField(input) {
    var wrap = document.createElement('div');
    wrap.className = 'hd-ac-wrap';
    input.parentNode.insertBefore(wrap, input);
    wrap.appendChild(input);

    var dropdown = document.createElement('ul');
    dropdown.className = 'hd-ac-dropdown';
    dropdown.style.display = 'none';
    wrap.appendChild(dropdown);

    var timer    = null;
    var activeIdx = -1;

    // Gibt den aktuell getippten Token zurueck (nach dem letzten Komma)
    function currentToken() {
      var parts = input.value.split(',');
      return parts[parts.length - 1].trimStart();
    }

    // Ersetzt den aktuellen Token durch den gewahlten Wert
    function selectEntry(label) {
      var val       = input.value;
      var lastComma = val.lastIndexOf(',');
      var prefix    = lastComma >= 0 ? val.substring(0, lastComma + 1) + ' ' : '';
      input.value   = prefix + label + ', ';
      closeDropdown();
      input.focus();
    }

    function closeDropdown() {
      dropdown.style.display = 'none';
      dropdown.innerHTML     = '';
      activeIdx              = -1;
    }

    function setActive(idx) {
      Array.prototype.forEach.call(dropdown.querySelectorAll('li'), function(li, i) {
        li.classList.toggle('hd-ac-active', i === idx);
      });
      activeIdx = idx;
    }

    function showResults(items) {
      dropdown.innerHTML = '';
      activeIdx          = -1;
      if (!items.length) { closeDropdown(); return; }
      items.forEach(function(item, idx) {
        var li        = document.createElement('li');
        li.textContent = item.label;
        li.addEventListener('mousedown', function(e) {
          e.preventDefault(); // verhindert blur vor click
          selectEntry(item.label);
        });
        li.addEventListener('mouseover', function() { setActive(idx); });
        dropdown.appendChild(li);
      });
      dropdown.style.display = 'block';
    }

    function fetchSuggestions(q) {
      if (cache[q]) { showResults(cache[q]); return; }
      fetch(AC_URL + '?q=' + encodeURIComponent(q), {
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          cache[q] = data;
          if (currentToken().trim() === q) showResults(data); // nur anzeigen wenn noch aktuell
        })
        .catch(function() {});
    }

    input.addEventListener('input', function() {
      clearTimeout(timer);
      var token = currentToken().trim();
      if (token.length < 2) { closeDropdown(); return; }
      timer = setTimeout(function() { fetchSuggestions(token); }, DEBOUNCE_MS);
    });

    input.addEventListener('keydown', function(e) {
      var items = dropdown.querySelectorAll('li');
      if (!items.length && e.key !== 'Escape') return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(Math.min(activeIdx + 1, items.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(Math.max(activeIdx - 1, 0));
      } else if ((e.key === 'Enter' || e.key === 'Tab') && activeIdx >= 0) {
        e.preventDefault();
        selectEntry(items[activeIdx].textContent);
      } else if (e.key === 'Escape') {
        closeDropdown();
      }
    });

    input.addEventListener('blur', function() {
      setTimeout(closeDropdown, 150); // kurze Pause, damit mousedown auf Eintrag noch feuert
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    ['hd-to', 'hd-cc', 'hd-bcc'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) setupField(el);
    });
  });
})();
//]]>
</script>
