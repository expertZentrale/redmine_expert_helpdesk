<%# Toolbar additions for the note field: quoting and answer templates.
    Rendered by the view_issues_edit_notes_bottom hook, regardless of whether a
    customer is linked to the ticket.
    Emits a JSON island only, no inline executable script (CSP-friendly).
    Locals: issue, project, templates, manage_url %>
<div id="hd-tb-flash" class="hd-tb-flash" style="display:none;"></div>

<script type="application/json" id="hd-note-toolbar-data"><%= json_escape({
  :textareaId => 'issue_notes',
  :postUrl    => issue_helpdesk_note_content_path(issue),
  :manageUrl  => manage_url,
  :templates  => templates.map { |t| { :id => t.id, :name => t.name, :global => t.global? } },
  :labels     => {
    :quote                => l(:label_helpdesk_quote),
    :quoteDescription     => l(:label_helpdesk_quote_original_mail),
    :quoteConversation    => l(:label_helpdesk_quote_conversation),
    :quoteMailConversation => l(:label_helpdesk_quote_mail_conversation),
    :templates            => l(:label_helpdesk_reply_templates),
    :templatesEmpty       => l(:label_helpdesk_reply_templates_empty),
    :templatesManage      => l(:label_helpdesk_reply_templates_manage),
    :globalSuffix         => l(:label_helpdesk_reply_template_global_suffix),
    :loading              => l(:label_helpdesk_note_content_loading),
    :truncated            => l(:text_helpdesk_quote_truncated),
    :failed               => l(:error_helpdesk_note_content_failed)
  }
}.to_json).html_safe %></script>
<%= javascript_include_tag 'helpdesk_note_toolbar', :plugin => 'redmine_expert_helpdesk' %>
