<%# Shared filter form of the statistics pages (period grouping, time range,
    custom dates). Locals: path, periods, ranges, period, range, date_from,
    date_to; optional extra (captured HTML for page-specific controls). %>
<%= form_tag path, :method => :get, :class => 'hd-stats-filter' do %>
  <label><%= l(:label_helpdesk_stats_group_by) %>:
    <%= select_tag :period,
          options_for_select(periods.map { |p| [l("label_helpdesk_stats_#{p}"), p] }, period),
          :id => 'hd-stats-period' %>
  </label>
  <label><%= l(:label_helpdesk_stats_range) %>:
    <%= select_tag :range,
          options_for_select(ranges.map { |r| [l("label_helpdesk_stats_range_#{r}"), r] }, range),
          :id => 'hd-stats-range' %>
  </label>
  <span id="hd-stats-custom-dates"<%= range == 'custom' ? '' : raw(' style="display:none;"') %>>
    <label><%= l(:label_helpdesk_stats_from) %>:
      <%= date_field_tag :date_from, date_from.iso8601 %></label>
    <label><%= l(:label_helpdesk_stats_to) %>:
      <%= date_field_tag :date_to, date_to.iso8601 %></label>
  </span>
  <%= local_assigns[:extra] %>
  <%= submit_tag l(:button_apply), :name => nil %>
<% end %>
