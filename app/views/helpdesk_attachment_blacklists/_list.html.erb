<%# Blacklisted attachment contents of one project.
    Locals: entries (Enumerable), project (Project)

    The digest is what actually matches, but a list of bare hashes is unreviewable -
    so the name, size and type of the copy the agent blacklisted are shown, and the
    hash only in short form as the tooltip of the name. %>
<% if entries.any? %>
<table class="list">
  <thead>
    <tr>
      <th><%= l(:field_filename) %></th>
      <th><%= l(:field_filesize) %></th>
      <th><%= l(:label_helpdesk_blacklist_hits) %></th>
      <th><%= l(:field_user) %></th>
      <th><%= l(:field_created_on) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% entries.each do |entry| %>
    <tr>
      <td><span title="<%= h(entry.digest) %>"><%= h(entry.label) %></span></td>
      <td><%= number_to_human_size(entry.filesize) %></td>
      <td>
        <%= entry.hit_count %>
        <% if entry.last_hit_at %>
          <em class="info">(<%= format_time(entry.last_hit_at) %>)</em>
        <% end %>
      </td>
      <td><%= entry.user ? link_to_user(entry.user) : '' %></td>
      <td><%= format_time(entry.created_on) %></td>
      <td class="buttons">
        <%= link_to hd_icon_label('del', l(:button_delete)),
                    helpdesk_attachment_blacklist_path(entry, :project_id => project),
                    :method => :delete,
                    :data => { :confirm => l(:text_are_you_sure) },
                    :class => 'icon icon-del' %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
