<h2><%= l(:label_helpdesk_reply_template_edit) %>: <%= h(@template.name) %></h2>

<%= form_tag hd_reply_template_path(@template, @project), :method => :put do %>
  <%= render :partial => 'form' %>
  <%= submit_tag l(:button_save) %>
  <%= link_to l(:button_cancel), hd_reply_templates_path(@project) %>
<% end %>
